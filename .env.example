# Abstrait — environment variables. Copy to `.env.local` and fill in.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.

# ── Required (Phase 1) ──────────────────────────────────────────────────────
# Neon Postgres pooled connection string (Neon dashboard → Connection Details).
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# ── Discord (Phase 2) ───────────────────────────────────────────────────────
# From the Discord Developer Portal → your application.
DISCORD_APP_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_BOT_TOKEN=""

# ── Auth (Phase 4) ──────────────────────────────────────────────────────────
# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Mirror channel (Phase 3) ────────────────────────────────────────────────
# Single-guild fallback; per-guild webhook URLs are stored in the database.
# Slack Incoming Webhook OR Discord channel webhook URL.
MIRROR_WEBHOOK_URL=""

# ── AI triage (Phase 6, stretch) ────────────────────────────────────────────
# Free Google AI Studio (Gemini) key. Leave AI_ENABLED=false to disable.
GEMINI_API_KEY=""
AI_ENABLED="false"

# ── Client-safe ─────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used for building links). Non-secret.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
